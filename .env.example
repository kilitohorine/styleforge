STYLEFORGE_DATA_DIR=./data
STYLEFORGE_HOST=127.0.0.1
STYLEFORGE_PORT=8000

# Optional: leave empty to use keyword routing (no LLM cost)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 2D generation (SiliconFlow). Empty key = Look still works, image.2d fails closed.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
IMAGE_2D_BACKEND=siliconflow
# Fallback 2D backend (switch IMAGE_2D_BACKEND=dashscope_wanxiang). Empty = fail closed.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_PATH=/services/aigc/text2image/image-synthesis
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
PROJECT_BUDGET_CNY=500
DAILY_BUDGET_CNY=20
ENABLE_CRITIQUE=true
MAX_CRITIQUE_STEP=2
ENABLE_MCTS=false
